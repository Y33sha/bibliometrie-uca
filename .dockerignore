# Secrets et données : la description de construction énumère ce qu'elle copie, et ces deux
# emplacements en sont absents. Les inscrire ici rend la garantie indépendante de cette
# énumération — le fichier d'environnement porte tous les secrets d'exploitation, et `data/`
# le stockage local des payloads sources.
.env
.env.*
!.env.example
data

# Git
.git
.gitignore

# Python
__pycache__
*.pyc
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache
.import_linter_cache
.coverage
htmlcov

# Frontend, reconstruit dans le conteneur
interfaces/frontend/node_modules
interfaces/frontend/.svelte-kit
interfaces/frontend/build

# IDE
.vscode
.idea

# Claude
.claude

# Journaux
logs
