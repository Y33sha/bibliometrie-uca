# Copier en .env (gitignored) et remplir les valeurs. `infrastructure/settings.py` et docker compose lisent ce fichier.
#
# Les réglages de sécurité sont à leur valeur de production, ou en commentaire quand c'est le défaut du code. Les assouplissements du développement local sont en commentaire, à décommenter sur le poste seulement : `docker-compose.prod.yml` reprend les valeurs de ce fichier.

# ---- Base de données ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bibliometrie
# Une identité de connexion par processus, exigée par ce processus. Le propriétaire se crée à la main ; `infrastructure/db/roles.sql` crée les deux autres.
#
# Propriétaire du schéma, pour les migrations seulement. Distinct de `POSTGRES_USER`, le superutilisateur du serveur.
DB_OWNER_USER=bibliometrie_owner
DB_OWNER_PASSWORD=changeme
# API : lecture, et écriture sur les tables que ses routes d'administration modifient.
DB_APP_USER=bibliometrie_app
DB_APP_PASSWORD=changeme
# Pipeline et scripts en ligne de commande : écriture sur les données, aucun droit sur le schéma.
DB_PIPELINE_USER=bibliometrie_pipeline
DB_PIPELINE_PASSWORD=changeme
# Mode SSL de libpq. Vide : `prefer`, chiffrement sans vérification du certificat. `verify-full` authentifie le serveur : valeur à poser dès que la base est sur une autre machine.
DB_SSLMODE=

# ---- Concurrence de l'API et pool de connexions (cf. `infrastructure/settings.py`) ----
API_THREADPOOL_SIZE=40
DB_POOL_MIN=2
DB_POOL_MAX=40

# ---- Admin (authentification) ----
ADMIN_USER=admin
# ADMIN_HASH et SESSION_SECRET sont exigés par l'API seulement.
# Générer avec : python -c "import bcrypt; print(bcrypt.hashpw(b'MOT_DE_PASSE', bcrypt.gensalt()).decode())"
# Quotes simples : python-dotenv interpole les $.
ADMIN_HASH='$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
# Clé de signature des jetons de session, 32 caractères au minimum. La changer invalide toutes les sessions.
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=changeme-generate-a-random-64-char-string-with-token-hex

# ---- Sécurité HTTP ----
# Cookie de session réservé à HTTPS (défaut). Pour un développement local en HTTP :
# COOKIE_SECURE=false
#
# Docs interactives (/docs, /redoc, /openapi.json), désactivées par défaut. En développement :
# EXPOSE_API_DOCS=true

# Adresses dont uvicorn accepte les en-têtes de proxy (X-Forwarded-For, X-Forwarded-Proto) : celle du dernier intermédiaire réseau devant l'application. En conteneur, la passerelle du réseau de déploiement (172.30.0.1, défaut de la composition de production) ; hors conteneur avec un proxy local, 127.0.0.1.
# Une valeur fausse fait ignorer l'en-tête : toutes les requêtes ont alors la même adresse, et le limiteur de tentatives ne distingue plus les clients. Le journal signale le cas (`proxy_headers_ignored`).
# FORWARDED_ALLOW_IPS=172.30.0.1

# Décalage maximal d'une lecture paginée. Le défaut dépasse le plus gros ensemble servi.
# MAX_PAGINATION_OFFSET=500000

# Exports CSV simultanés. Un export compose sa réponse en mémoire ; au-delà du plafond, la demande reçoit un 503. Dimensionner selon la mémoire du conteneur et la taille du corpus.
# MAX_CONCURRENT_EXPORTS=5

# ---- Identifiants d'accès aux sources externes (pipeline) ----
# Une source sans identifiants est sautée, avec un avertissement. HAL, theses.fr, DOI.org et DOAJ sont publiques.
OPENALEX_API_KEY=
WOS_API_KEY=
SCANR_USERNAME=
SCANR_PASSWORD=
# Adresse annoncée aux API à polite pool : exigée par Crossref, DataCite et Unpaywall ; pour OpenAlex, à défaut de clé. Une adresse inventée expose à un blocage : mettre une adresse réelle.
POLITE_POOL_EMAIL=

# ---- CORS (origines autorisées à appeler l'API) ----
# Origines séparées par des virgules ; `*` est refusé, les appels envoyant le cookie de session. Vide en production, où l'API sert le frontend. Pour le serveur de développement du frontend :
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Docker : PostgreSQL (conteneur db) ----
POSTGRES_DB=bibliometrie
POSTGRES_USER=postgres
# Superutilisateur du conteneur PostgreSQL, lu par docker compose seulement. Mot de passe aléatoire, propre à chaque environnement : python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=changeme

# ---- Dev local : ports et cible du proxy vite ----
# `start.sh` lance l'API sur API_PORT et vite sur FRONT_PORT. Le proxy de vite vise API_TARGET s'il est renseigné, sinon API_PORT. Le frontend Docker reçoit API_TARGET de docker-compose.yml.
API_PORT=8000
FRONT_PORT=5173
API_TARGET=

# ---- Préfixe de déploiement ----
# Chemin sous lequel l'application est servie, identique pour le frontend (BASE_PATH, lu au build) et l'API (ROOT_PATH, lu à l'exécution). Vider les deux pour servir à la racine.
BASE_PATH=/bibliometrie
ROOT_PATH=/bibliometrie

# ---- Logs ----
# Logs sur stdout par défaut. En développement, pour un historique sur disque (logs/<path>/<name>.log) :
# LOG_TO_FILE=true
# LOG_FORMAT=text   # json par défaut
