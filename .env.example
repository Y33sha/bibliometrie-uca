# Copier en .env (gitignored) et remplir les valeurs.
# python-dotenv charge ce fichier au démarrage (via config/settings.py).
# docker-compose l'utilise également (via env_file et substitution ${VAR}).
# En prod, ces variables doivent être injectées par l'orchestrateur (pm2, systemd, docker).

# ---- Base de données ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bibliometrie
# Identité principale : propriétaire du schéma. Les migrations, le pipeline et les
# scripts de maintenance s'en servent — eux seuls modifient la structure, rafraîchissent
# les vues matérialisées et vident des tables. Requise pour ces usages, et pour eux seuls :
# un processus qui ne sert que l'API n'a pas à la porter, et `docker-compose.prod.yml` ne
# la donne qu'au service `pipeline`.
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=changeme
# Identité restreinte dont l'API se sert : un rôle limité à la lecture et à l'écriture
# des données, créé par `infrastructure/db/roles.sql`. Requise — l'API refuse de démarrer
# sans elle, plutôt que de se rabattre en silence sur l'identité propriétaire.
DB_APP_USER=bibliometrie_app
DB_APP_PASSWORD=changeme
# Mode SSL (libpq) : disable/prefer/require/verify-ca/verify-full. Vide = défaut du driver,
# soit `prefer` : chiffrement si le serveur le propose, certificat non vérifié. `require` rend
# le chiffrement obligatoire sans vérifier davantage — un intercepteur présentant n'importe
# quel certificat passe. Seuls `verify-ca` et `verify-full` authentifient le serveur, le second
# vérifiant en plus le nom d'hôte : c'est la valeur à poser dès que la base est déportée.
DB_SSLMODE=

# ---- Pool de connexions ----
# DB_POOL_MIN : connexions persistantes (toujours ouvertes).
# DB_POOL_MAX : pic max sous charge ; le différentiel (max - min) est ouvert
# à la demande puis refermé. Ratio max/min recommandé : ~1:15. Bumper à 50+
# si l'API admin charge plusieurs facettes simultanées et qu'on observe des
# TimeoutError côté pool (pool_timeout). Surveiller en parallèle
# `pg_stat_activity` côté Postgres (limite globale `max_connections`).
DB_POOL_MIN=2
DB_POOL_MAX=30

# ---- Admin (authentification) ----
ADMIN_USER=admin
# Les deux valeurs qui suivent sont exigées du processus qui sert l'API, et de lui seul :
# le pipeline et les scripts de maintenance lisent ce fichier sans jamais ouvrir de session.
# Générer avec : python -c "import bcrypt; print(bcrypt.hashpw(b'MOT_DE_PASSE', bcrypt.gensalt()).decode())"
# Entourer de quotes simples pour éviter l'interpolation des $ par python-dotenv.
ADMIN_HASH='$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
# Clé de signature des jetons de session, 32 caractères au minimum — l'API refuse de démarrer
# en deçà, une clé courte se retrouvant par force brute hors ligne. En changer la valeur (puis
# redémarrer) invalide tous les jetons émis : c'est le levier de déconnexion globale.
SESSION_SECRET=changeme-generate-a-random-64-char-string-with-token-hex

# ---- Sécurité HTTP ----
# Cookie de session marqué Secure (HTTPS uniquement). Vrai par défaut ; mettre à
# false pour un développement local servi en HTTP clair, sinon le navigateur
# refuse le cookie et la connexion admin échoue.
COOKIE_SECURE=false
# Docs interactives (/docs, /redoc, /openapi.json). Faux par défaut (production) ;
# activer en développement pour explorer l'API.
EXPOSE_API_DOCS=true
# Adresses depuis lesquelles les en-têtes de proxy (X-Forwarded-For, X-Forwarded-Proto)
# font foi. Lue par uvicorn au démarrage, elle vaut l'adresse du dernier maillon réseau
# devant l'application.
#
# En conteneur, ce maillon est la passerelle du réseau de déploiement, y compris quand le
# proxy tourne sur l'hôte et joint le port publié sur la boucle locale : la composition de
# production fixe le sous-réseau et en donne la passerelle (172.30.0.1) par défaut.
# Hors conteneur, avec un proxy sur la même machine, la valeur est 127.0.0.1.
#
# Un réglage qui ne couvre pas le pair fait écarter l'en-tête : toutes les requêtes portent
# alors la même adresse, et le limiteur de tentatives cesse de distinguer les clients. Le cas
# se signale au journal (`proxy_headers_ignored`), avec l'adresse à porter ici.
# FORWARDED_ALLOW_IPS=172.30.0.1

# Plafond du décalage qu'une lecture paginée peut demander (rang de page × taille de page).
# Sans borne, un rang arbitrairement grand fait trier à la base l'ensemble du résultat pour n'en
# rendre aucune ligne. La valeur par défaut (500 000) passe au-delà du plus gros ensemble servi ;
# la relever est le geste à faire le jour où un ensemble la dépasse. Au-delà du plafond, la
# marche à suivre est de filtrer — l'export porte le même plafond et ne rend pas davantage.
# MAX_PAGINATION_OFFSET=500000

# Nombre d'exports CSV menés de front. Un export compose sa réponse en mémoire avant de
# l'envoyer : ce plafond borne ce que le processus porte à un instant donné, là où le plafond de
# lignes borne le coût d'un export et celui de fréquence le coût d'une rafale venue d'un même
# client. Au-delà, la demande reçoit un 503 et se reprend.
#
# La valeur se dimensionne sur le coût d'un export sans filtre, rapporté à la mémoire allouée au
# conteneur : une croissance du corpus, ou un conteneur plus étroit, la font revoir.
# MAX_CONCURRENT_EXPORTS=5

# ---- Identifiants d'accès aux sources externes (pipeline) ----
# Une source dont les identifiants manquent est sautée au lancement, avec un avertissement :
# renseigner seulement celles qu'on veut interroger. HAL, theses.fr, DOI.org et DOAJ sont des
# API publiques, sans identifiant.
OPENALEX_API_KEY=
WOS_API_KEY=
SCANR_USERNAME=
SCANR_PASSWORD=
# Adresse annoncée aux API qui pratiquent le polite pool. Requise par Crossref, DataCite et
# Unpaywall ; pour OpenAlex, elle vaut à défaut de clé d'API. Une adresse inventée expose à un
# blocage côté serveur : mettre une adresse réelle et relevée.
POLITE_POOL_EMAIL=

# ---- CORS (origines autorisées à appeler l'API) ----
# Liste d'origines séparées par des virgules. `*` est refusé au démarrage : les appels
# portent le cookie de session, et le joker autoriserait n'importe quel site à s'en servir
# depuis le navigateur de la personne connectée. Vide en production, où l'API sert elle-même
# le frontend (même origine) ; renseigné en développement, le serveur de développement du
# frontend vivant sur un autre port.
CORS_ORIGINS=http://localhost:5176,http://localhost:5173,http://127.0.0.1:5176

# ---- Docker : PostgreSQL (conteneur db) ----
POSTGRES_DB=bibliometrie
POSTGRES_USER=postgres
# Mot de passe du superutilisateur du conteneur PostgreSQL, lu par docker compose et par lui
# seul (l'application se connecte sous DB_OWNER_USER ou DB_APP_USER). Le tirer au hasard, et
# distinct par environnement : python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=changeme

# ---- Dev local : cible du proxy vite (le frontend Docker, lui, reçoit API_TARGET via docker-compose.yml) ----
API_TARGET=http://127.0.0.1:8003

# ---- Préfixe de déploiement ----
# URL sous laquelle l'appli est servie. Préfixe `/bibliometrie` par défaut :
# c'est l'URL partagée en dev sur le réseau local et le sous-chemin attendu
# derrière un reverse-proxy qui transmet ce préfixe. Doit matcher entre frontend
# (BASE_PATH, consommé au build SvelteKit) et backend (ROOT_PATH, passé à uvicorn
# en `--root-path`). docker-compose.prod.yml propage ROOT_PATH au build et au
# runtime. Pour servir à la racine (ex. accès direct sur :8003 sans proxy),
# vider les deux variables.
BASE_PATH=/bibliometrie
ROOT_PATH=/bibliometrie

# ---- Logs ----
# Par défaut l'app n'écrit les logs que sur stdout (12-factor). En dev local,
# décommenter pour garder un historique sur disque (logs/<path>/<name>.log).
# En prod, laisser désactivé : le runtime (Docker, systemd, k8s) capture stdout.
# LOG_TO_FILE=true
# LOG_FORMAT=text   # json par défaut ; text en dev si besoin de lisibilité
