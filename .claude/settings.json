{
  "remoteControlAtStartup": false,
  "permissions": {
    "allow": [
      "Bash(awk '{print $2}')",
      "Bash(git --no-pager diff --cached --stat)",
      "Bash(git commit *)",
      "Bash(git --no-pager log --oneline -1)",
      "Bash(xargs wc -l)",
      "Bash(find . -path ./node_modules -prune -o -name \"*.yml\" -path \"*.github*\" -print)",
      "Bash(ls .github/workflows/)",
      "Bash(python -m ruff check .)",
      "Bash(python -m ruff format --check .)",
      "Bash(lint-imports)",
      "Bash(python -m ruff check . --output-format=concise)",
      "Bash(python -m mypy:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send -u critical 'Claude Code' 'Permission demandée'"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send -u normal 'Claude Code' 'En attente'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send -u low 'Claude Code' 'Terminé'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/vale_check.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/presentism_guard.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/doc_style_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/redirect_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
