{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:gen": "cd ../.. && python -m interfaces.cli.dev.dump_openapi && cd interfaces/frontend && openapi-typescript openapi.json -o src/lib/api/schema.ts && rm openapi.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/d3-cloud": "^1.2.9",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.4.0",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/parser": "^8.68.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "happy-dom": "^20.11.12",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-chart-geo": "^4.3.6",
    "chartjs-plugin-datalabels": "^2.2.0",
    "d3-cloud": "^1.2.9",
    "dompurify": "^3.4.14",
    "i18n-iso-countries": "^7.14.0",
    "katex": "^0.18.4",
    "topojson-client": "^3.1.0",
    "vis-network": "^10.1.2",
    "world-atlas": "^2.0.2"
  }
}
