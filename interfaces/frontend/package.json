{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:gen": "cd ../.. && uv run python -m interfaces.cli.dev.dump_openapi && cd interfaces/frontend && openapi-typescript openapi.json -o src/lib/api/schema.ts && rm openapi.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.73.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "happy-dom": "^21.0.3",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.74.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "d3-cloud": "^2.0.0",
    "dompurify": "^3.4.18",
    "i18n-iso-countries": "^7.14.0",
    "katex": "^0.19.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
