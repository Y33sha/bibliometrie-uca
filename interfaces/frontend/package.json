{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:gen": "cd ../.. && uv run python -m interfaces.cli.dev.dump_openapi && cd interfaces/frontend && openapi-typescript openapi.json -o src/lib/api/schema.ts && rm openapi.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-cloud": "^1.2.9",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/parser": "^8.72.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "happy-dom": "^21.0.3",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "chart.js": "^4.5.1",
    "chartjs-chart-geo": "^4.3.6",
    "chartjs-plugin-datalabels": "^2.2.0",
    "d3-cloud": "^1.2.9",
    "dompurify": "^3.4.17",
    "i18n-iso-countries": "^7.14.0",
    "katex": "^0.19.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
